# Git Ignore Patterns

# IDE and Project Tools
.strategist/
.analysis/
.sdd/
.superpowers/
.vscode/
.idea/
docs/superpowers/
.agents/
.cursor/
.hypothesis/
.claude/
.codex/
.gemini/





# Python Cache
__pycache__/
*.pyc
*.pyo
*.pyd

# Test and Lint Cache
.pytest_cache/
.pytest_tmp/
airflow_openapi.json
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Environment and Virtualenv
.venv/
venv/
ENV/
env/
.env*

# GCP Service Account Keys — NEVER commit these
*-sa-key.json
*service_account*.json
*credentials*.json
gcp-key*.json
personal-project-*.json
keys/*.pem
keys/*.key

# Logs and Outputs
logs/
*.log
generated/
dags/
data/
bin/
scratch/
dev.db

# OTG Specific Pipeline Execution Scripts & Data
scripts/*otg*.py
scripts/*OTG*.py
*otg*
*OTG*
