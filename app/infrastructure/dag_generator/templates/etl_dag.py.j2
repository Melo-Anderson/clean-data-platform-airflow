{# platform/infrastructure/dag_generator/templates/etl_dag.py.j2 #}
{# Airflow 3 — pipeline.type = "etl"                              #}
{# 12 tasks in 4 TaskGroups                                       #}
# DAG definition for Airflow — commit: {{ commit_hash }}
{% from "_shared_macros.j2" import dag_imports, pipeline_asset, dag_schedule, dag_default_args %}
{{ dag_imports(pipeline) }}
from airflow.sdk import TaskGroup
from app.infrastructure.airflow_callbacks.etl_callbacks import (
    validate_source_models,
    classify_schema_changes,
    submit_transformation_job,
    publish_documentation,
)

{{ pipeline_asset(pipeline) }}

@dag(
    dag_id="{{ pipeline.name | sanitize_dag_id }}",
    description="ETL pipeline — generated by platform. Do not edit manually.",
    {{ dag_schedule(pipeline) }}
    {{ dag_default_args(pipeline) }}
    tags={{ pipeline.airflow.tags | to_py }},
    catchup=False,
    max_active_runs=1,
    on_failure_callback=alert_and_monitoring,
)
def {{ pipeline.name | sanitize_identifier }}_dag():

    with TaskGroup(group_id="pre_flight") as pre_flight:
        @task(task_id="01_check_dependencies", pool="{{ pipeline.airflow.pool }}")
        def _check_dependencies(**context):
            """MANDATORY."""
            return check_dependencies(
                pipeline_id="{{ pipeline.id }}",
                depends_on={{ pipeline.schedule.depends_on | default([]) | to_py }},
                logical_date=context.get("logical_date") or context.get("data_interval_start"),
            )

        @task(task_id="02_validate_source_models", pool="{{ pipeline.airflow.pool }}")
        def _validate_source_models(**context):
            """MANDATORY: Validates dbt/Dataform models exist and are fresh."""
            return validate_source_models(
                pipeline_id="{{ pipeline.id }}",
                asset_name="{{ pipeline.source_asset_name }}",
            )

        @task(task_id="03_classify_schema_changes", pool="{{ pipeline.airflow.pool }}")
        def _classify_schema_changes(source_models, **context):
            """MANDATORY: Blocks if schema changes are incompatible with transformation."""
            return classify_schema_changes(source_models=source_models)

        deps = _check_dependencies()
        models = _validate_source_models()
        deps >> models
        _classify_schema_changes(models)

{% if pipeline.compute.engine == "dbt" %}
{% from "_compute_engine_dbt_cosmos.j2" import compute_engine_dbt_cosmos %}
{{ compute_engine_dbt_cosmos(pipeline) }}
{% else %}
{% from "_compute_engine_generic.j2" import compute_engine_generic %}
{{ compute_engine_generic(pipeline) }}
{% endif %}

    with TaskGroup(group_id="validation_and_metrics") as validation_group:
        @task(task_id="01_read_transformation_metrics", pool="{{ pipeline.airflow.pool }}")
        def _read_transformation_metrics(execution_result, **context):
            """OPTIONAL (soft_fail): Reads transformation metrics.json."""
            from app.infrastructure.storage_reader import StorageReader
            metrics_path = (execution_result or {}).get("metrics_path")
            return StorageReader().read_json(metrics_path) or {}

        @task(task_id="02_quality_gate", pool="{{ pipeline.airflow.pool }}")
        def _quality_gate(metrics, **context):
            """MANDATORY."""
            return quality_gate(
                pipeline_id="{{ pipeline.id }}",
                metrics=metrics or {},
                quality_rules={{ pipeline.quality.metrics | to_py }},
            )

        metrics_result = _read_transformation_metrics(validate_exec)
        _quality_gate(metrics_result)

    with TaskGroup(group_id="observability") as observability_group:
        @task(task_id="01_publish_documentation", pool="{{ pipeline.airflow.pool }}")
        def _publish_documentation(**context):
            """OPTIONAL (soft_fail): Publishes dbt/Dataform docs to catalog."""
            publish_documentation(pipeline_id="{{ pipeline.id }}", transform_ref="{{ pipeline.compute.select }}")

        @task(task_id="02_emit_lineage", pool="{{ pipeline.airflow.pool }}")
        def _emit_lineage(execution_result, **context):
            """OPTIONAL (soft_fail): Emits transformation lineage to catalog."""
            from app.infrastructure.adapters.platform import get_lineage_client
            schema_path = (execution_result or {}).get("schema_path")
            get_lineage_client().emit_etl_lineage(
                pipeline_id="{{ pipeline.id }}",
                transform_ref="{{ pipeline.compute.select }}",
                schema_path=schema_path,
            )

        @task(
            task_id="03_emit_monitoring_and_sla",
            trigger_rule="all_done",
            pool="{{ pipeline.airflow.pool }}"
        )
        def _emit_monitoring(**context):
            """OPTIONAL (soft_fail) + trigger_rule=all_done. Persists PipelineRun."""
            ti = context["ti"]
            dag_run = context["dag_run"]

            quality_result = ti.xcom_pull(task_ids="validation_and_metrics.02_quality_gate") or {}
            quality_ok = quality_result.get("quality_ok", True)
            quality_violations = quality_result.get("violations", [])

            transform_result = ti.xcom_pull(task_ids="compute_engine.03_validate_transformation_execution")

            if not quality_ok:
                final_status = "quality_failed"
                failed_task = "validation_and_metrics.02_quality_gate"
            elif transform_result is None:
                final_status = "failed"
                failed_task = "compute_engine"
            else:
                final_status = "success"
                failed_task = None

            metrics = ti.xcom_pull(task_ids="validation_and_metrics.01_read_transformation_metrics") or {}
            emit_monitoring_and_sla(
                pipeline_id="{{ pipeline.id }}",
                pipeline_name="{{ pipeline.name }}",
                pipeline_type="etl",
                dag_run_id=str(dag_run.run_id),
                sla_minutes={{ pipeline.airflow.sla_minutes }},
                metrics=metrics,
                dag_run_start=str(dag_run.start_date),
                status=final_status,
                failed_task=failed_task,
                optional_failures=[],
                quality_violations=quality_violations if final_status == "quality_failed" else [],
            )

        @task(task_id="04_success_notification", outlets=[_PIPELINE_ASSET], pool="{{ pipeline.airflow.pool }}")
        def _success_notification(**context):
            """OPTIONAL (soft_fail): Synchronous success notification."""
            success_notification(
                pipeline_id="{{ pipeline.id }}",
                pipeline_name="{{ pipeline.name }}",
                owner="{{ pipeline.owner }}",
            )

        docs = _publish_documentation()
        lin = _emit_lineage(validate_exec)
        docs >> lin
        monitoring = _emit_monitoring()
        lin >> monitoring
        notif = _success_notification()
        lin >> notif

    pre_flight >> compute_engine_group
    compute_engine_group >> validation_group
    validation_group >> observability_group

{{ pipeline.name | sanitize_identifier }}_dag()
