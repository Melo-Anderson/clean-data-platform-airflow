{# platform/infrastructure/dag_generator/templates/transformation_dag.py.j2 #}
{# Airflow 3 — pipeline.type = "transformation" #}
# DAG definition for Airflow — commit: {{ commit_hash }}
{% from "_shared_macros.j2" import dag_imports, pipeline_asset, pipeline_outlets, dag_schedule, dag_default_args %}
{{ dag_imports(pipeline) }}

from app.infrastructure.airflow_callbacks.transformation_callbacks import (
    run_transformation_job,
    evaluate_transformation_quality_gates,
    sync_transformation_catalog_metadata,
)

{{ pipeline_asset(pipeline) }}
{{ pipeline_outlets(pipeline) }}

@dag(
    dag_id="{{ pipeline.name | sanitize_dag_id }}",
    description="Transformation pipeline — generated by platform. Do not edit manually.",
    {{ dag_schedule(pipeline) }}
    {{ dag_default_args(pipeline) }}
    catchup=False,
    max_active_runs=1,
    tags={{ pipeline.airflow.tags | tojson }},
    on_failure_callback=alert_and_monitoring,
    params={"pipeline_id": {{ pipeline.id | tojson }}, "pipeline_type": "transformation"},
)
def {{ pipeline.name | sanitize_identifier }}_dag():

    @task(task_id="run_transformations", outlets=pipeline_outlets)
    def _run_transformations(**context):
        return run_transformation_job(
            pipeline_id="{{ pipeline.id }}",
            output_base_dir="{{ pipeline.compute.staging_bucket }}",
            engine="{{ pipeline.compute.engine }}",
            project_dir="{{ pipeline.compute.config.get('project_dir', '') }}" or None,
            profiles_dir="{{ pipeline.compute.config.get('profiles_dir', '') }}" or None,
            select_models="{{ pipeline.compute.select }}",
            config={{ pipeline.compute.config | tojson }},
        )

    @task(task_id="evaluate_quality_gates")
    def _evaluate_quality_gates(job_result, **context):
        return evaluate_transformation_quality_gates(
            pipeline_id="{{ pipeline.id }}",
            metrics_path=job_result["metrics_path"],
            quality_rules={{ pipeline.quality.metrics | tojson }},
            engine="{{ pipeline.compute.engine }}",
        )

    @task(task_id="sync_catalog_and_lineage")
    def _sync_catalog_and_lineage(**context):
        return sync_transformation_catalog_metadata(
            asset_id="{{ pipeline.id }}",
            manifest_path="{{ pipeline.compute.config.get('manifest_path', '') }}",
            engine="{{ pipeline.compute.engine }}",
        )

    @task(task_id="emit_monitoring_and_sla", trigger_rule="all_done")
    def _emit_monitoring(q_gate_result=None, **context):
        dag_run = context["dag_run"]
        qg_data = context["ti"].xcom_pull(task_ids="evaluate_quality_gates")
        quality_ok = isinstance(qg_data, dict) and qg_data.get("quality_ok") is True
        final_status = "success" if quality_ok else "quality_failed"
        failed_task = None if quality_ok else "evaluate_quality_gates"
        quality_violations = [] if quality_ok else (qg_data or {}).get("violations", ["Quality evaluation unavailable"])

        emit_monitoring_and_sla(
            pipeline_id="{{ pipeline.id }}",
            pipeline_name="{{ pipeline.name }}",
            pipeline_type="transformation",
            dag_run_id=str(dag_run.run_id),
            sla_minutes={{ pipeline.airflow.sla_minutes }},
            dag_run_start=str(dag_run.start_date),
            status=final_status,
            failed_task=failed_task,
            metrics=(qg_data or {}).get("metrics", {}),
            quality_violations=quality_violations,
        )

    transform = _run_transformations()
    q_gate = _evaluate_quality_gates(transform)
    sync = _sync_catalog_and_lineage()
    monitoring = _emit_monitoring(q_gate)

    transform >> q_gate >> sync >> monitoring


{{ pipeline.name | sanitize_identifier }}_dag()
