{# Airflow 3 — pipeline.type = "transformation" #}
from __future__ import annotations

from datetime import datetime, timezone
from airflow.decorators import dag, task
from airflow.sdk import Asset

{% from "_shared_macros.j2" import dag_imports, pipeline_asset, pipeline_outlets, dag_schedule, dag_default_args %}
from app.infrastructure.airflow_callbacks.transformation_callbacks import (
    run_dbt_transformation_job,
    evaluate_dbt_quality_gates,
    sync_dbt_catalog_metadata,
)
from app.infrastructure.airflow_callbacks.shared_callbacks import (
    emit_monitoring_and_sla,
)

{{ pipeline_asset(pipeline) }}
{{ pipeline_outlets(pipeline) }}

@dag(
    dag_id="{{ pipeline.name | sanitize_dag_id }}",
    description="Transformation pipeline — generated by platform. Do not edit manually.",
    {{ dag_schedule(pipeline) }}
    start_date=datetime(2026, 1, 1, tzinfo=timezone.utc),
    catchup=False,
    max_active_runs=1,
    tags={{ pipeline.airflow.tags | tojson }},
)
def {{ pipeline.name | sanitize_identifier }}_dag():

    @task(task_id="run_dbt_transformations", outlets=pipeline_outlets)
    def _run_dbt_transformations(**context):
        return run_dbt_transformation_job(
            pipeline_id="{{ pipeline.id }}",
            project_dir="/opt/airflow/dbt_project",
            profiles_dir="/opt/airflow/dbt_project",
            output_base_dir="{{ pipeline.compute.staging_bucket }}",
            select_models="{{ pipeline.compute.select | default('') }}",
        )

    @task(task_id="evaluate_quality_gates")
    def _evaluate_quality_gates(job_result, **context):
        return evaluate_dbt_quality_gates(
            pipeline_id="{{ pipeline.id }}",
            metrics_path=job_result["metrics_path"],
            quality_rules={{ pipeline.quality.metrics | tojson }},
        )

    @task(task_id="sync_catalog_and_lineage")
    def _sync_catalog_and_lineage(**context):
        return sync_dbt_catalog_metadata(
            asset_id="{{ pipeline.id }}",
            manifest_path="/opt/airflow/dbt_project/target/manifest.json",
        )

    @task(task_id="emit_monitoring_and_sla", trigger_rule="all_done")
    def _emit_monitoring(q_gate_result=None, **context):
        dag_run = context["dag_run"]
        final_status = "success"
        failed_task = None
        quality_violations = []

        qg_data = context["ti"].xcom_pull(task_ids="evaluate_quality_gates") or {}
        if not qg_data.get("quality_ok", True):
            final_status = "quality_failed"
            failed_task = "evaluate_quality_gates"
            quality_violations = qg_data.get("violations", [])

        emit_monitoring_and_sla(
            pipeline_id="{{ pipeline.id }}",
            pipeline_name="{{ pipeline.name }}",
            pipeline_type="transformation",
            dag_run_id=str(dag_run.run_id),
            sla_minutes={{ pipeline.airflow.sla_minutes }},
            dag_run_start=str(dag_run.start_date),
            status=final_status,
            failed_task=failed_task,
            metrics=qg_data.get("metrics", {}),
            quality_violations=quality_violations,
        )

    transform = _run_dbt_transformations()
    q_gate = _evaluate_quality_gates(transform)
    sync = _sync_catalog_and_lineage()
    monitoring = _emit_monitoring(q_gate)

    transform >> q_gate >> sync >> monitoring


{{ pipeline.name | sanitize_identifier }}_dag = {{ pipeline.name | sanitize_identifier }}_dag()
