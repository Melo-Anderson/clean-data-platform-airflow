# .env.example — Copy to .env and fill in real values. NEVER commit .env.

# Airflow
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_min_32_chars
AIRFLOW__API_AUTH__JWT_SECRET=change_me_min_32_chars
AIRFLOW_EXECUTOR=LocalExecutor

# Platform API
PLATFORM_SECRET_KEY=change_me_in_production
PLATFORM_VAULT_TOKEN=change_me_use_short_lived_token

# GCP — absolute path on your local machine to the GCP service account JSON
GOOGLE_APPLICATION_CREDENTIALS_HOST=/path/to/your/gcp-key.json

# JWT public key — path to PEM file on host
PLATFORM_AUTH_JWT_PUBLIC_KEY_PEM_FILE=./keys/jwt_public.pem

# Observability (optional, set to enable OTLP export)
OTEL_EXPORTER_OTLP_ENDPOINT=
